# Staging configuration for testing Google Demo Key safely
# Do not commit real keys. Keep this file as template only.

WAYWISE_MOCK_MODE=false
WAYWISE_MAP_PROVIDER=google
WAYWISE_ENABLE_GOOGLE_FALLBACK=true
GOOGLE_MAPS_API_KEY=PASTE_YOUR_GOOGLE_DEMO_KEY_HERE

# The google provider draws on a Google map, which needs a separate browser key.
# Restrict it to this site's HTTP referrer and to the Maps JavaScript API only;
# it is visible in the page source. Never reuse GOOGLE_MAPS_API_KEY here.
GOOGLE_MAPS_JS_API_KEY=PASTE_YOUR_REFERRER_RESTRICTED_KEY_HERE
# Optional: a Map ID from the Cloud console. DEMO_MAP_ID works for testing.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Keep conservative limits while testing. These are deliberately tighter than the
# defaults in backend/app.py (25 / 8 / 8) because every point and destination here
# is a billed Google call.
DISTANCE_MATRIX_MAX_DESTINATIONS=10
FREE_MAX_SEARCH_POINTS=4
GOOGLE_MAX_SEARCH_POINTS=4
